function Help_Get(code as String) as Object
    title = "Error desconocido"
    description = "La operación no pudo completarse."
    cause = "La aplicación recibió una respuesta o un estado inesperado."
    action = "Presiona Atrás para regresar y vuelve a intentarlo una sola vez."
    if code = "VOD-005"
        title = "Formato multimedia no compatible"
        description = "El Roku recibió un formato que no pudo reproducir."
        cause = "El códec, perfil, contenedor o archivo puede no ser compatible con este Roku."
        action = "Vuelve a detalles. Prueba otra fuente disponible o revisa las capacidades en Ajustes."
    else if code = "VOD-001"
        title = "Película o episodio no disponible"
        description = "El contenido solicitado no está disponible en este momento."
        cause = "El título pudo retirarse, cambiar de enlace o quedar temporalmente fuera de servicio."
        action = "Regresa al catálogo, abre de nuevo el título o inténtalo más tarde."
    else if code = "VOD-002"
        title = "Error al cargar contenido"
        description = "La película o episodio no pudo iniciar correctamente."
        cause = "El servidor tardó demasiado, la conexión falló o el archivo llegó incompleto."
        action = "Usa Reintentar una vez. Si vuelve a fallar, prueba otro título y revisa tu conexión."
    else if code = "VOD-003"
        title = "Fuente de video no disponible"
        description = "Ninguna de las fuentes autorizadas respondió correctamente."
        cause = "Las fuentes disponibles están caídas, retiradas o no responden."
        action = "Vuelve a detalles y prueba más tarde u otro contenido."
    else if code = "VOD-004"
        title = "Reproducción interrumpida"
        description = "La reproducción terminó antes de completar el contenido."
        cause = "La conexión o el servidor dejó de enviar datos durante la reproducción."
        action = "Usa Reintentar. Si falla siempre en el mismo punto, el archivo puede estar dañado."
    else if code = "LIVE-001"
        title = "Canal sin transmisión"
        description = "El canal no está enviando video en este momento."
        cause = "La señal está caída, cambió de fuente o no logró iniciar."
        action = "Espera el salto automático o selecciona otro canal de la misma sección."
    else if code = "LIVE-002"
        title = "Buffering prolongado"
        description = "El canal tardó demasiado tiempo en continuar la reproducción."
        cause = "La red está inestable o el servidor entrega segmentos con retraso."
        action = "Revisa Wi-Fi o Ethernet y prueba otro canal si la señal no se recupera."
    else if code = "LIVE-003"
        title = "No quedan canales disponibles"
        description = "No se encontró una transmisión funcional en esta sección."
        cause = "Los canales permitidos fallaron, están vacíos o no tienen una señal válida."
        action = "Abre Secciones y elige otra. Puedes volver a probar esta sección más tarde."
    else if code = "LIVE-004"
        title = "Transmisión interrumpida"
        description = "La señal del canal terminó inesperadamente."
        cause = "La fuente cambió o se cortó mientras el reproductor estaba activo."
        action = "Selecciona otro canal o vuelve a abrir la sección actual."
    else if code = "NET-001"
        title = "Sin conexión a Internet"
        description = "El Roku no pudo acceder a Internet."
        cause = "Se perdió Wi-Fi o Ethernet, o el router no tiene salida a Internet."
        action = "Comprueba la red en Configuración de Roku y luego utiliza Reintentar."
    else if code = "NET-002"
        title = "Conexión inestable"
        description = "La red no respondió dentro del tiempo esperado."
        cause = "Puede haber señal Wi-Fi débil, congestión o pérdida de paquetes."
        action = "Acerca el Roku al router, evita descargas y vuelve a intentar."
    else if code = "API-001"
        title = "Servidor IPTV sin respuesta"
        description = "El servicio no respondió a la solicitud de la aplicación."
        cause = "El servidor puede estar caído, saturado o fuera del tiempo de espera."
        action = "Confirma que Internet funciona, espera un momento y usa Reintentar."
    else if code = "API-002"
        title = "Respuesta no válida"
        description = "El servidor respondió con datos incompletos o no reconocidos."
        cause = "La sesión pudo expirar o el acceso dejó de ser válido."
        action = "Revisa el acceso mediante el procedimiento oficial y no compartas credenciales."
    else if code = "API-003"
        title = "Sesión no disponible"
        description = "La sesión del proveedor no pudo validarse en este momento."
        cause = "La respuesta llegó vacía o el servicio está actualizando la lista."
        action = "Comprueba la conexión y vuelve a cargar sin borrar la configuración."
    else if code = "PROXY-001"
        title = "Error del proxy local"
        description = "El proxy local no pudo preparar la transmisión solicitada."
        cause = "El servidor local, su puerto o la tarea de segmentos no pudo iniciar."
        action = "Regresa a TV en vivo y reproduce otra señal; si persiste, reinicia la app."
    else if code = "PROXY-002"
        title = "Segmento no disponible"
        description = "Falta un fragmento necesario para reproducir la transmisión."
        cause = "El servidor retiró el segmento o el manifiesto ya no coincide con la señal."
        action = "Espera la recuperación o prueba otro canal. Intenta esta señal más tarde."
    else if code = "PIN-001"
        title = "PIN incorrecto"
        description = "El PIN introducido no coincide con el configurado en este Roku."
        cause = "Las cifras escritas no corresponden al PIN guardado."
        action = "Introdúcelo de nuevo con cuidado o presiona Atrás para cancelar."
    else if code = "PIN-002"
        title = "PIN temporalmente bloqueado"
        description = "Se alcanzó el límite de intentos permitidos."
        cause = "Se introdujo una clave incorrecta varias veces."
        action = "Espera a que termine el bloqueo o presiona Atrás para volver al menú."
    else if code = "UI-001"
        title = "Error de navegación"
        description = "La pantalla no pudo completar la acción solicitada."
        cause = "La interfaz perdió datos, mantuvo un filtro o no terminó de cargar."
        action = "Regresa al menú de la sección y ábrela de nuevo."
    else if code = "APP-002"
        title = "Operación no disponible"
        description = "Esta operación no pudo completarse de forma segura."
        cause = "El foco, un diálogo o el reproductor quedó en un estado incorrecto."
        action = "Presiona Atrás una vez. Si no responde, sal con HOME y abre la app de nuevo."
    else if code = "APP-001"
        title = "Error inesperado"
        description = "Un componente interno produjo un error no previsto."
        cause = "La aplicación recibió información inesperada o encontró un defecto interno."
        action = "Regresa con Atrás o abre de nuevo la aplicación si se cerró."
    end if
    return {
        code: code,
        title: title,
        description: description,
        cause: cause,
        action: action
    }
end function
